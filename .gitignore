node_modules/
dist/
out/
# 「別のフォルダを開く」で開いたフォルダごとの出力先(<out>-folders/)
out-folders/
# 利用者ごとの設定(手元のパスを含む。雛形は atlas.config.example.json)
atlas.config.json
# 設定ファイルを書き換える間だけ作るロック(落ちると残ることがある)
atlas.config.json.lock
# 利用者のメモとグループ(セッション ID や自由記述を含む)
atlas-notes/
# テスト時に生成する fixture(架空の値だけ。サンプルデータはリポジトリに置かない)
.fixtures/
*.log
.claude/launch.json

# impeccable critique のスナップショット(実データの件数を含むのでコミットしない)
.impeccable/critique/

# Rust のビルド出力
/target/
