{
  "name": "agent-session-atlas",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "atlas": "node packages/cli/src/main.ts",
    "atlas:judge": "node packages/cli/src/judge-flow.ts",
    "build:report": "npm run build -w @atlas/report",
    "typecheck": "tsc -p tsconfig.json && npm run check -w @atlas/report",
    "test": "vitest run --project unit",
    "e2e": "vitest run --project e2e",
    "fixtures": "node scripts/synthetic-fixtures.ts",
    "ui": "vitest run --project ui",
    "audit:ui": "node scripts/ui-audit.ts",
    "smoke": "node scripts/smoke-local.ts",
    "ci": "npm run typecheck && npm test && npm run build:report && npm run e2e && npm run ui && npm run smoke"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "playwright": "^1.65.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
